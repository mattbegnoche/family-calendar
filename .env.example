# Copy to .env.local for development. In production these are set on the host
# (Vercel → Settings → Environment Variables). Values here are placeholders.

# --- Database (Neon) -------------------------------------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by the Prisma CLI. Migrations need DDL and advisory
# locks, which must not go through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="replace-me"

# Google OAuth client. The authorised redirect URI must be, exactly:
#   http://localhost:3000/api/auth/callback/google        (development)
#   https://YOUR-DOMAIN/api/auth/callback/google          (production)
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# PRODUCTION ONLY. Pins the callback URL so a forged Host header cannot
# redirect the OAuth code, and switches on trustHost. Leave unset locally.
# AUTH_URL="https://family-calendar-neon-one.vercel.app"

# --- Access ----------------------------------------------------------------
# OPTIONAL sign-in allow-list, comma-separated. LEAVE IT EMPTY for normal
# multi-family operation: any family can sign up, create their own household
# and invite the other adults with their own code.
#
# NOTE the reversal — empty used to lock everybody out, and now means open.
# Set it only to pin a private deployment shut, e.g. during a closed beta.
ALLOWED_EMAILS=

# --- Family invite codes ---------------------------------------------------
# REQUIRED. Keys both halves of the invite-code scheme in
# src/lib/family-code.ts: the HMAC blind index a typed code is looked up by,
# and the AES-256-GCM encryption that lets an owner read their code back.
# Codes are never stored in plain text.
#
#   openssl rand -base64 32
#
# CHANGING THIS makes every existing code unreadable and unmatchable. Owners
# recover by generating a new code from Settings; nothing else breaks.
FAMILY_CODE_SECRET="replace-me"

# --- Household seed --------------------------------------------------------
# Read by `pnpm db:seed`. OPTIONAL and superseded by the onboarding flow at
# /onboarding — kept for local development only. A seeded household has no
# readable invite code; generate one from Settings.
# Kept out of source so a public repo carries no family data. Colours must be
# 6-digit hex; the database enforces it.
HOUSEHOLD_NAME="The Example Family"
HOUSEHOLD_TIME_ZONE="America/Chicago"
HOUSEHOLD_MEMBERS='[{"slug":"everyone","name":"Household","color":"#4f46e5","kind":"SHARED"},{"slug":"adult-one","name":"Adult One","color":"#0891b2"},{"slug":"child-one","name":"Child One","color":"#7c3aed"}]'
# Links a login to a member once that person has signed in at least once.
HOUSEHOLD_USER_LINKS='[{"email":"you@example.com","slug":"adult-one"}]'

# --- Google Calendar (read-only import) ------------------------------------
# No extra variables: the same OAuth client above is used. Two things to do in
# Google Cloud Console for the project that owns AUTH_GOOGLE_ID:
#   1. Enable the "Google Calendar API" (APIs & Services → Library).
#   2. While the OAuth consent screen is in Testing, add every Google account
#      that will connect a calendar as a test user, or Google refuses consent.
# Calendar scopes are only requested when someone clicks "Connect Google
# Calendar" in Settings, never at sign-in. See src/lib/google/scopes.ts.
