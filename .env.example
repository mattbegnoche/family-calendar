# Copy to .env.local for development. In production these are set on the host
# (Vercel → Settings → Environment Variables). Values here are placeholders.

# --- Database (Neon) -------------------------------------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by the Prisma CLI. Migrations need DDL and advisory
# locks, which must not go through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="replace-me"

# Google OAuth client. The authorised redirect URI must be, exactly:
#   http://localhost:3000/api/auth/callback/google        (development)
#   https://YOUR-DOMAIN/api/auth/callback/google          (production)
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# PRODUCTION ONLY. Pins the callback URL so a forged Host header cannot
# redirect the OAuth code, and switches on trustHost. Leave unset locally.
# AUTH_URL="https://family-calendar-neon-one.vercel.app"

# --- Access ----------------------------------------------------------------
# Comma-separated. Anyone not listed is refused at sign-in. An EMPTY value
# locks everybody out, including you.
ALLOWED_EMAILS="you@example.com,partner@example.com"

# --- Household seed --------------------------------------------------------
# Read by `pnpm db:seed`. Kept out of source so a public repo carries no
# family data. Colours must be 6-digit hex; the database enforces it.
HOUSEHOLD_NAME="The Example Family"
HOUSEHOLD_TIME_ZONE="America/Chicago"
HOUSEHOLD_MEMBERS='[{"slug":"everyone","name":"Household","color":"#4f46e5","kind":"SHARED"},{"slug":"adult-one","name":"Adult One","color":"#0891b2"},{"slug":"child-one","name":"Child One","color":"#7c3aed"}]'
# Links a login to a member once that person has signed in at least once.
HOUSEHOLD_USER_LINKS='[{"email":"you@example.com","slug":"adult-one"}]'
